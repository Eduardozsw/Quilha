# Caminho do vault Obsidian (fonte da verdade da carreira)
VAULT_PATH=~/Obsidian

# Banco do Quilha (vagas, competências, estudos, execuções)
HERMES_DB=data/hermes.db

# Termos que não podem sair da máquina (ver denylist.example.yaml)
HERMES_DENYLIST=denylist.yaml

# --- LLM (conversa, vagas, currículos). Sem isso, o que não usa LLM funciona normalmente. ---
# Modelo no formato LiteLLM
LLM_MODEL=gpt-4o-mini
# Chave do provedor (OpenAI, Anthropic, OpenRouter...)
LLM_API_KEY=
# Só para provedor local (ex: http://localhost:11434)
LLM_API_BASE=
# Tentativas e timeout por chamada (o LiteLLM faz o backoff)
LLM_NUM_RETRIES=3
LLM_TIMEOUT=60
# Teto de custo por sessão de chat, em dólares
HERMES_MAX_COST_USD=0.50

# --- Estudos ---
# Pasta cujos subdiretórios git são lidos por `hermes study git` (commits viram sinal, não estudo)
# Padrão: ~/Projetos. Descomente para usar outra pasta.
# HERMES_REPOS_DIR=~/codigo
# Tools do chat que gravam sem pedir confirmação (vazio = todas pedem)
HERMES_SEM_CONFIRMACAO=log_study,git_activity

# --- Coleta de vagas ---
# Fontes de vagas (ver fontes.example.yaml)
HERMES_FONTES=fontes.yaml

# --- MCP ---
# Servidores MCP (ver mcp.example.yaml). Arquivo ausente = chat sem tools externas.
HERMES_MCP=mcp.yaml

# --- Backup ---
# Pasta das cópias do banco (`hermes backup`). Evidência e nível só existem no banco.
HERMES_BACKUP_DIR=data/backups

# --- Candidaturas e e-mail ---
# De onde vêm os e-mails do `email sync`: `gmail` (OAuth próprio, abaixo) ou `imap` (senha de app)
EMAIL_ORIGEM=gmail
# IMAP: servidor, e-mail e senha de app (Conta Google → Segurança → Senhas de app; exige verificação em 2 etapas)
IMAP_HOST=imap.gmail.com
IMAP_USUARIO=
IMAP_SENHA=
# Pasta com credentials.json do Gmail (OAuth Desktop) e os tokens gerados na 1ª autorização
HERMES_GMAIL_DIR=data/gmail
# Quem classifica os e-mails no `email sync`: `llm` (o modelo de LLM_MODEL, padrão) ou `jev`
EMAIL_CLASSIFICADOR=llm
# Só com EMAIL_CLASSIFICADOR=jev: chave do Jev (console.typesafe.ai)
TYPESAFE_API_KEY=
